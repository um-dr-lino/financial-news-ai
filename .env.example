# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/financial_news_ai

# ============================================
# Authentication
# ============================================
JWT_SECRET=sua-chave-secreta-super-segura-com-pelo-menos-32-caracteres

# ============================================
# AI Services
# ============================================
# Groq API (usado para gerar resumos de notícias)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# OpenAI API (opcional, para integração futura)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# ============================================
# News APIs (Opcionais)
# ============================================
# NewsAPI - para notícias internacionais
NEWSAPI_KEY=xxxxxxxxxxxxxxxxxxxxx

# GNews - para notícias globais
GNEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Environment
# ============================================
NODE_ENV=production
PORT=3000
